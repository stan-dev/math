if(NOT EXISTS "${STAN_STANC_FILE}")
  if(CMAKE_HOST_WIN32)
    set(platform windows)
  elseif(CMAKE_HOST_APPLE)
    set(platform mac)
  else()
    set(platform linux)
  endif()
  find_program(curl_program NAMES curl)
  if(NOT curl_program)
    message(FATAL_ERROR "Downloading the expression test compiler requires curl")
  endif()
  execute_process(COMMAND "${curl_program}" -L --fail --retry 5 --retry-delay 10
    "https://github.com/stan-dev/stanc3/releases/download/nightly/${platform}-stanc"
    -o "${STAN_STANC_FILE}" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    file(REMOVE "${STAN_STANC_FILE}")
    message(FATAL_ERROR "Downloading the expression test compiler failed")
  endif()
  if(NOT CMAKE_HOST_WIN32)
    execute_process(COMMAND chmod +x "${STAN_STANC_FILE}" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Setting expression test compiler permissions failed")
    endif()
  endif()
endif()
